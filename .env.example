# Copy to .env and fill in. .env is git-ignored; never commit credentials.

# --- Source dataset (NYC Open Data) -------------------------------------------
LL84_DATASET_ID=5zyy-y8am            # LL84 2023-present (calendar years 2022+)
SOCRATA_DOMAIN=data.cityofnewyork.us
SOCRATA_APP_TOKEN=                   # optional, avoids throttling: https://data.cityofnewyork.us/profile/edit/developer_settings

# --- AWS -------------------------------------------------------------------------
# Leave S3_BUCKET empty to run everything locally (./data) with no AWS account.
AWS_REGION=us-east-1
S3_BUCKET=                           # globally unique, e.g. ll84-energy-yourname-2026
S3_RAW_PREFIX=raw/ll84
S3_CURATED_PREFIX=curated/ll84
GLUE_DATABASE=ll84
GLUE_JOB_NAME=ll84-transform
GLUE_ROLE_NAME=ll84-glue-role
ATHENA_WORKGROUP=ll84-wg
ATHENA_SCAN_LIMIT_BYTES=1073741824   # Athena refuses queries scanning more than this

# --- Postgres (docker compose up -d) ---------------------------------------------
DATABASE_URL=postgresql://ll84:ll84@localhost:5432/ll84

# --- Year-over-year EUI flagging ------------------------------------------------
YOY_PCT_THRESHOLD=0.5     # flag when EUI changes by 50%+ vs prior year
PEER_Z_THRESHOLD=3.5      # robust z-score of the change vs same-type peers
IQR_MULTIPLIER=3.0        # peer range = Q1 - k*IQR .. Q3 + k*IQR
MIN_PEER_GROUP=20         # peer rules only for groups with at least this many buildings

LOCAL_DATA_DIR=data
LL84_LOG_DIR=logs
